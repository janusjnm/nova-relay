[Unit]
Description=nova-relay watchdog (VPS: tick + ask a running box to resume over Tailscale ssh; detects and records an unreachable box, cannot wake it)
After=network-online.target tailscaled.service

[Service]
Type=oneshot
# nova-relay appends one JSON line per run to ~/.nova-relay/run/watchdog.log itself (rotated at
# 5 MB under a lock, one .1 kept, 0600). Do not add a StandardOutput=append: redirect to that file.
ExecStart=%h/.local/bin/nova-relay watchdog
